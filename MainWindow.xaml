<Window x:Class="VivaldiUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vivaldi Updater"
        Width="560" Height="565"
        MaxHeight="{Binding Height, Source={x:Static SystemParameters.WorkArea}}"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"
        Loaded="MainWindow_OnLoaded" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="tinyStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TitleButton" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Margin" Value="2,0,0,0" />
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="HitArea" Background="{TemplateBinding Background}"
                                    BorderThickness="1" CornerRadius="7">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HitArea" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="HitArea" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="HitArea" Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ComponentRow" TargetType="Grid">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Margin" Value="12,2" />
            </Style>

            <Style x:Key="VersionText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            </Style>

            <Style x:Key="SettingRow" TargetType="Border">
                <Setter Property="MinHeight" Value="41" />
                <Setter Property="Padding" Value="2,4" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="{DynamicResource SurfaceSecondaryBrush}" />
            </Style>

            <Style x:Key="SettingLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Margin" Value="0,0,16,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="MainComboBox" TargetType="ComboBox" BasedOn="{StaticResource AppleComboBoxStyle}">
                <Setter Property="Margin" Value="0" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}"
            BorderThickness="1" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Opacity="0.16" ShadowDepth="2" Color="#342A30" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="20,0,12,0" Background="Transparent" MouseLeftButtonDown="HandleDrag">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ManualUpdateAppCommand}"
                            AutomationProperties.Name="{Binding LocalizedNewVersionFoundLabel}"
                            ToolTip="{Binding LocalizedNewVersionFoundLabel}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TitleButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAppUpdateAvailable}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource UpdateIconGeometry}"
                              Fill="{DynamicResource WarningBrush}" />
                    </Button>
                    <Button Command="{Binding ConfigureProxyCommand}" Style="{StaticResource TitleButton}"
                            AutomationProperties.Name="&#x4EE3;&#x7406;&#x8BBE;&#x7F6E; / Proxy settings"
                            ToolTip="&#x4EE3;&#x7406;&#x8BBE;&#x7F6E; / Proxy settings">
                        <Path Data="M1,8 A7,7 0 1 1 15,8 A7,7 0 1 1 1,8 M1,8 H15 M8,1 C4,4 4,12 8,15 M8,1 C12,4 12,12 8,15"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Click="MinimizeButton_OnClick" Style="{StaticResource TitleButton}"
                            AutomationProperties.Name="&#x6700;&#x5C0F;&#x5316; / Minimize"
                            ToolTip="&#x6700;&#x5C0F;&#x5316; / Minimize">
                        <Path Data="M0,0 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Click="CloseButton_OnClick" Style="{StaticResource TitleButton}"
                            AutomationProperties.Name="&#x5173;&#x95ED; / Close" ToolTip="&#x5173;&#x95ED; / Close">
                        <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Text="Vivaldi Updater" />
                    <TextBlock Margin="10,1,0,0" Style="{StaticResource VersionText}"
                               Text="{Binding AppVersion, StringFormat=v{0}}" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="10" Padding="0,4">
                    <StackPanel>
                    <Grid Style="{StaticResource ComponentRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="126" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="{Binding LocalizedVivaldiBrowserLabel}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource VersionText}"
                                   Text="{Binding VivaldiInstalledVersion, TargetNullValue=--}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource VersionText}" Text="&#x2192;" />
                        <TextBlock Grid.Column="3" Style="{StaticResource VersionText}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding VivaldiLatestVersion, TargetNullValue=--}" />
                        <Border Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource ComponentStatusBadgeStyle}" Tag="{Binding VivaldiStatus}">
                            <TextBlock Text="{Binding VivaldiUpdateNotifyText}" Style="{StaticResource ComponentStatusTextStyle}" />
                        </Border>
                    </Grid>
                        <Border Margin="12,0" Height="1" Background="{DynamicResource SurfaceBorderBrush}" Opacity="0.55" />
                    <Grid Style="{StaticResource ComponentRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="126" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="{Binding LocalizedVivaldiPlusPluginLabel}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource VersionText}"
                                   Text="{Binding VivaldiPlusInstalledVersion, TargetNullValue=--}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource VersionText}" Text="&#x2192;" />
                        <TextBlock Grid.Column="3" Style="{StaticResource VersionText}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="{Binding VivaldiPlusLatestVersion, TargetNullValue=--}" />
                        <Border Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource ComponentStatusBadgeStyle}" Tag="{Binding VivaldiPlusStatus}">
                            <TextBlock Text="{Binding VivaldiPlusUpdateNotifyText}" Style="{StaticResource ComponentStatusTextStyle}" />
                        </Border>
                    </Grid>
                    </StackPanel>
                </Border>

                <TabControl Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource AppleTabControlStyle}">
                    <TabControl.Resources>
                        <Style TargetType="ScrollBar">
                            <Setter Property="Width" Value="14" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Grid Background="Transparent" Margin="0,2">
                                            <Border x:Name="Rail" Width="5" CornerRadius="3" Opacity="0"
                                                    Background="{DynamicResource TrackOffBrush}" IsHitTestVisible="False" />
                                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                                </Track.DecreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb>
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Grid Background="Transparent">
                                                                    <Border x:Name="Grip" Width="5" CornerRadius="3"
                                                                            Background="{DynamicResource TextMutedBrush}" Opacity="0.60" />
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Grip" Property="Width" Value="7" />
                                                                        <Setter TargetName="Grip" Property="Opacity" Value="0.82" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsDragging" Value="True">
                                                                        <Setter TargetName="Grip" Property="Width" Value="7" />
                                                                        <Setter TargetName="Grip" Property="Opacity" Value="1" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                                </Track.IncreaseRepeatButton>
                                            </Track>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Rail" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                    <TabItem Header="{Binding LocalizedBasicSettingsLabel}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,4,0,0">
                                <Border Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <ToggleButton DockPanel.Dock="Right" Width="46" Height="32"
                                                      AutomationProperties.Name="{Binding LocalizedAutoUpdateVivaldiLabel}"
                                                      IsChecked="{Binding EnableVivaldiUpdate, Mode=TwoWay}"
                                                      Style="{StaticResource AppleToggleButtonStyle}" />
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding LocalizedAutoUpdateVivaldiLabel}" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <ToggleButton DockPanel.Dock="Right" Width="46" Height="32"
                                                      AutomationProperties.Name="{Binding LocalizedEnableVivaldiPlusLabel}"
                                                      IsChecked="{Binding EnableVivaldiPlus, Mode=TwoWay}"
                                                      Style="{StaticResource AppleToggleButtonStyle}" />
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding LocalizedEnableVivaldiPlusLabel}" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <ToggleButton DockPanel.Dock="Right" Width="46" Height="32"
                                                      AutomationProperties.Name="{Binding LocalizedAutoUpdateVivaldiPlusLabel}"
                                                      IsChecked="{Binding EnableVivaldiPlusUpdate, Mode=TwoWay}"
                                                      Style="{StaticResource AppleToggleButtonStyle}" />
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding LocalizedAutoUpdateVivaldiPlusLabel}" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <ToggleButton DockPanel.Dock="Right" Width="46" Height="32"
                                                      AutomationProperties.Name="{Binding LocalizedEnableAppUpdateLabel}"
                                                      IsChecked="{Binding EnableAppUpdate, Mode=TwoWay}"
                                                      Style="{StaticResource AppleToggleButtonStyle}" />
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding LocalizedEnableAppUpdateLabel}" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <ToggleButton DockPanel.Dock="Right" Width="46" Height="32"
                                                      AutomationProperties.Name="{Binding LocalizedUseMirrorAddressLabel}"
                                                      IsChecked="{Binding UseMirrorAddress, Mode=TwoWay}"
                                                      Style="{StaticResource AppleToggleButtonStyle}" />
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding LocalizedUseMirrorAddressLabel}" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <ComboBox DockPanel.Dock="Right" Width="124" Height="32"
                                                  AutomationProperties.Name="{Binding LocalizedLanguageLabel}"
                                                  DisplayMemberPath="DisplayName" SelectedValuePath="Tag"
                                                  ItemsSource="{Binding LanguageOptions}"
                                                  SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                                                  ItemContainerStyle="{StaticResource AppleComboBoxItemStyle}"
                                                  Style="{StaticResource MainComboBox}" />
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding LocalizedLanguageLabel}" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <ComboBox DockPanel.Dock="Right" Width="124" Height="32"
                                                  AutomationProperties.Name="{Binding LocalizedThemeLabel}"
                                                  DisplayMemberPath="DisplayName" SelectedValuePath="Tag"
                                                  ItemsSource="{Binding ThemeOptions}"
                                                  SelectedValue="{Binding SelectedTheme, Mode=TwoWay}"
                                                  ItemContainerStyle="{StaticResource AppleComboBoxItemStyle}"
                                                  Style="{StaticResource MainComboBox}" />
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding LocalizedThemeLabel}" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{Binding LocalizedUpdateSettingsLabel}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,4,0,0">
                                <Border Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <ToggleButton DockPanel.Dock="Right" Width="46" Height="32"
                                                      AutomationProperties.Name="{Binding LocalizedDeleteInstallerAfterUpdateLabel}"
                                                      IsChecked="{Binding DeleteFullInstallerAfterUpdate, Mode=TwoWay}"
                                                      Style="{StaticResource AppleToggleButtonStyle}" />
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding LocalizedDeleteInstallerAfterUpdateLabel}" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <ToggleButton DockPanel.Dock="Right" Width="46" Height="32"
                                                      AutomationProperties.Name="{Binding LocalizedCleanBackupAfterUpdateLabel}"
                                                      IsChecked="{Binding CleanBackupAfterUpdate, Mode=TwoWay}"
                                                      Style="{StaticResource AppleToggleButtonStyle}" />
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding LocalizedCleanBackupAfterUpdateLabel}" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>

            <StackPanel Grid.Row="2" Margin="20,8,20,16">
                <Border Margin="0,0,0,10" Padding="12,10" CornerRadius="8"
                        Background="{DynamicResource SurfaceSecondaryBrush}" Visibility="{Binding ShowUpdateProcessBar}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0"
                                       Text="{Binding DownloadProgress, StringFormat={}{0}%}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource VersionText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDownloadIndeterminate}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock FontSize="13" FontWeight="SemiBold" MaxHeight="34"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       AutomationProperties.LiveSetting="Polite" Text="{Binding ProcessBarNotifyText}"
                                       ToolTip="{Binding ProcessBarNotifyText}" />
                        </DockPanel>
                        <ProgressBar Height="6" Margin="0,7,0,0" IsIndeterminate="{Binding IsDownloadIndeterminate}"
                                     Style="{StaticResource MacOSProgressBarStyle}" Value="{Binding DownloadProgress}" />
                        <TextBlock Margin="0,6,0,0" FontSize="12" MaxHeight="32"
                                   Foreground="{DynamicResource TextSubtleBrush}"
                                   Text="{Binding DownloadDetailText}" ToolTip="{Binding DownloadDetailText}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Button Height="40" MinWidth="168" HorizontalAlignment="Right" FontSize="14"
                        AutomationProperties.Name="{Binding Operation}"
                        Command="{Binding ApplyCommand}" Content="{Binding Operation}"
                        Style="{StaticResource ApplePriButtonStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
