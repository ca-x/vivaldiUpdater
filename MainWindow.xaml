                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding ElementName=windowsHeader, Path=ActualHeight}" />
                        <ColumnDefinition Width="{Binding ElementName=windowsHeader, Path=ActualHeight}" />
                        <ColumnDefinition Width="3" />
                    </Grid.ColumnDefinitions>
                    <Button
                        AutomationProperties.Name="最小化 / Minimize"
                        Click="MinimizeButton_OnClick"
                        Style="{StaticResource AppleButtonStyle}">
                        <Viewbox>
                            <Ellipse
                                Width="15"
                                Height="15"
                                Fill="#FFDAD404"
                                Stroke="#FFFDFDFD"
                                StrokeThickness="0.5" />
                        </Viewbox>
                    </Button>
                    <Button
                        x:Name="closeButton"
                        Grid.Column="1"
                        AutomationProperties.Name="关闭 / Close"
                        Click="CloseButton_OnClick"
                        Style="{StaticResource AppleButtonStyle}">
                        <Viewbox>
                            <Ellipse
                                Width="15"
                                Height="15"
                                Fill="#FFEE7408"
                                Stroke="#FFFDFDFD"
                                StrokeThickness="0.5" />
                        </Viewbox>
                    </Button>
                </Grid>
            </Grid>
            <Border
                Grid.Row="1"
                Margin="12,6,12,12"
                Padding="12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="20">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="66" />
                </Grid.RowDefinitions>
                <!--  display info  -->
                <Border
                    Margin="6,0"
                    Padding="12,8"
                    Background="{DynamicResource SurfaceSecondaryBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <!--  vivaldi info  -->
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            Width="120"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Text="{Binding LocalizedVivaldiBrowserLabel}" />
                        <Grid Width="170" Margin="20,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextSubtleBrush}"
                                Text="{Binding VivaldiInstalledVersion, TargetNullValue=--}" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextSubtleBrush}"
                                Text="→" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource SuccessBrush}"
                                Text="{Binding VivaldiLatestVersion, TargetNullValue=--}" />
                        </Grid>
                        
                         <!-- Update Status -->
                        <Grid Margin="20,0,0,0">
                            <!-- Icon for Update Available -->
                            <Path Data="{StaticResource UpdateIconGeometry}" Fill="{DynamicResource WarningBrush}" Width="16" Height="16" HorizontalAlignment="Left" Stretch="Uniform" VerticalAlignment="Center">
                                 <Path.Style>
                                     <Style TargetType="Path">
                                         <Setter Property="Visibility" Value="Collapsed"/>
                                         <Style.Triggers>
                                             <DataTrigger Binding="{Binding IsVivaldiUpdateAvailable}" Value="True">
                                                 <Setter Property="Visibility" Value="Visible"/>
                                             </DataTrigger>
                                         </Style.Triggers>
                                     </Style>
                                 </Path.Style>
                            </Path>
                            <!-- Text for No Update -->
                            <TextBlock
                                Margin="22,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource InfoBrush}"
                                Text="{Binding VivaldiUpdateNotifyText}" />
                        </Grid>
                    </StackPanel>

                    <!--  vivaldi++ info  -->
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            Width="120"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Text="{Binding LocalizedVivaldiPlusPluginLabel}" />
                        <Grid Width="170" Margin="20,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextSubtleBrush}"
                                Text="{Binding VivaldiPlusInstalledVersion, TargetNullValue=--}" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextSubtleBrush}"
                                Text="→" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource SuccessBrush}"
                                Text="{Binding VivaldiPlusLatestVersion, TargetNullValue=--}" />
                        </Grid>
                        
                         <!-- Update Status -->
                         <Grid Margin="20,0,0,0">
                            <Path Data="{StaticResource UpdateIconGeometry}" Fill="{DynamicResource WarningBrush}" Width="16" Height="16" HorizontalAlignment="Left" Stretch="Uniform" VerticalAlignment="Center">
                                 <Path.Style>
                                     <Style TargetType="Path">
                                         <Setter Property="Visibility" Value="Collapsed"/>
                                         <Style.Triggers>
                                             <DataTrigger Binding="{Binding IsVivaldiPlusUpdateAvailable}" Value="True">
                                                 <Setter Property="Visibility" Value="Visible"/>
                                             </DataTrigger>
                                         </Style.Triggers>
                                     </Style>
                                 </Path.Style>
                            </Path>
                            <TextBlock
                                Margin="22,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource InfoBrush}"
                                Text="{Binding VivaldiPlusUpdateNotifyText}" />
                        </Grid>
                    </StackPanel>
                    

                </StackPanel>
                </Border>
                <!--  Options  -->
                <!--  Options  -->
                <TabControl Grid.Row="1" Margin="6,6,6,0" Style="{StaticResource AppleTabControlStyle}">
                    <TabItem Header="{Binding LocalizedBasicSettingsLabel}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,6,0,0">
                            <!--  auto patch with vivaldi++  -->
                            <Grid Width="360" Margin="0,2" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{Binding LocalizedAutoUpdateVivaldiLabel}"
                                    TextWrapping="Wrap" />
                                <ToggleButton
                                    Grid.Column="1"
                                    Width="100"
                                    Height="35"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding LocalizedAutoUpdateVivaldiLabel}"
                                    IsChecked="{Binding EnableVivaldiUpdate, Mode=TwoWay}"
                                    Style="{StaticResource AppleToggleButtonStyle}" />
                            </Grid>
                            <!--  auto patch with vivaldi++  -->
                            <Grid Width="360" Margin="0,2" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{Binding LocalizedEnableVivaldiPlusLabel}"
                                    TextWrapping="Wrap" />
                                <ToggleButton
                                    Grid.Column="1"
                                    Width="100"
                                    Height="35"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding LocalizedEnableVivaldiPlusLabel}"
                                    IsChecked="{Binding EnableVivaldiPlus, Mode=TwoWay}"
                                    Style="{StaticResource AppleToggleButtonStyle}" />
                            </Grid>
                            <!--  update vivaldi++  -->
                            <Grid Width="360" Margin="0,2" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{Binding LocalizedAutoUpdateVivaldiPlusLabel}"
                                    TextWrapping="Wrap" />
                                <ToggleButton
                                    Grid.Column="1"
                                    Width="100"
                                    Height="35"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding LocalizedAutoUpdateVivaldiPlusLabel}"
                                    IsChecked="{Binding EnableVivaldiPlusUpdate, Mode=TwoWay}"
                                    Style="{StaticResource AppleToggleButtonStyle}" />
                            </Grid>
                            <!--  Enable App Self Update  -->
                            <Grid Width="360" Margin="0,2" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{Binding LocalizedEnableAppUpdateLabel}"
                                    TextWrapping="Wrap" />
                                <ToggleButton
                                    Grid.Column="1"
                                    Width="100"
                                    Height="35"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding LocalizedEnableAppUpdateLabel}"
                                    IsChecked="{Binding EnableAppUpdate, Mode=TwoWay}"
                                    Style="{StaticResource AppleToggleButtonStyle}" />
                            </Grid>
                            <!--  use mirror address  -->
                            <Grid Width="360" Margin="0,2" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{Binding LocalizedUseMirrorAddressLabel}"
                                    TextWrapping="Wrap" />
                                <ToggleButton
                                    Grid.Column="1"
                                    Width="100"
                                    Height="35"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding LocalizedUseMirrorAddressLabel}"
                                    IsChecked="{Binding UseMirrorAddress, Mode=TwoWay}"
                                    Style="{StaticResource AppleToggleButtonStyle}" />
                            </Grid>
                            <!--  language selection  -->
                            <Grid Width="360" Margin="0,2" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{Binding LocalizedLanguageLabel}"
                                    TextWrapping="Wrap" />
                                <ComboBox
                                    Grid.Column="1"
                                    Width="110"
                                    Height="35"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding LocalizedLanguageLabel}"
                                    DisplayMemberPath="DisplayName"
                                    ItemContainerStyle="{StaticResource AppleComboBoxItemStyle}"
                                    ItemsSource="{Binding LanguageOptions}"
                                    SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                                    SelectedValuePath="Tag"
                                    Style="{StaticResource AppleComboBoxStyle}" />
                            </Grid>
                            <!--  theme selection  -->
                            <Grid Width="360" Margin="0,2" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{Binding LocalizedThemeLabel}"
                                    TextWrapping="Wrap" />
                                <ComboBox
                                    Grid.Column="1"
                                    Width="110"
                                    Height="35"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding LocalizedThemeLabel}"
                                    DisplayMemberPath="DisplayName"
                                    ItemContainerStyle="{StaticResource AppleComboBoxItemStyle}"
                                    ItemsSource="{Binding ThemeOptions}"
                                    SelectedValue="{Binding SelectedTheme, Mode=TwoWay}"
                                    SelectedValuePath="Tag"
                                    Style="{StaticResource AppleComboBoxStyle}" />
                            </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{Binding LocalizedUpdateSettingsLabel}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,6,0,0">
                             <!--  Delete Full Installer  -->
                            <Grid Width="420" Margin="0,2" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{Binding LocalizedDeleteInstallerAfterUpdateLabel}"
                                    TextWrapping="Wrap" />
                                <ToggleButton
                                    Grid.Column="1"
                                    Width="100"
                                    Height="35"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding LocalizedDeleteInstallerAfterUpdateLabel}"
                                    IsChecked="{Binding DeleteFullInstallerAfterUpdate, Mode=TwoWay}"
                                    Style="{StaticResource AppleToggleButtonStyle}" />
                            </Grid>
                             <!--  Clean Backup  -->
                            <Grid Width="420" Margin="0,2" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{Binding LocalizedCleanBackupAfterUpdateLabel}"
                                    TextWrapping="Wrap" />
                                <ToggleButton
                                    Grid.Column="1"
                                    Width="100"
                                    Height="35"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding LocalizedCleanBackupAfterUpdateLabel}"
                                    IsChecked="{Binding CleanBackupAfterUpdate, Mode=TwoWay}"
                                    Style="{StaticResource AppleToggleButtonStyle}" />
                            </Grid>



                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
                <Border
                    Grid.Row="2"
                    Margin="6,8,6,0"
                    Padding="12,10"
                    Background="{DynamicResource SurfaceSecondaryBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{Binding ShowUpdateProcessBar}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="{Binding ProcessBarNotifyText}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource AccentPressedBrush}"
                                Text="{Binding DownloadProgress, StringFormat={}{0}%}" />
                        </Grid>
                        <ProgressBar
                            Grid.Row="1"
                            Height="10"
                            Margin="0,8,0,0"
                            IsIndeterminate="{Binding IsDownloadIndeterminate}"
                            Maximum="100"
                            Style="{StaticResource MacOSProgressBarStyle}"
                            Value="{Binding DownloadProgress}" />
                        <TextBlock
                            Grid.Row="2"
                            Margin="0,6,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextSubtleBrush}"
                            Text="{Binding DownloadDetailText}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
                <Button
                    Grid.Row="3"
                    Height="44"
                    Margin="6,10,6,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{Binding Operation}"
                    Command="{Binding ApplyCommand}"
                    Content="{Binding Operation}"
                    Style="{StaticResource ApplePriButtonStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Border>


</Window>
